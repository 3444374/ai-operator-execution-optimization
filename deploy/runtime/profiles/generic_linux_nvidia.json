{
  "schema_version": 1,
  "kind": "machine_profile",
  "name": "generic_linux_nvidia",
  "match": {
    "priority": 0,
    "platforms": ["Linux"],
    "minimum_gpu_count": 1,
    "minimum_gpu_memory_mib": 8000
  },
  "platforms": ["Linux"],
  "minimum_python": [3, 10],
  "minimum_cpu_slots": 4,
  "required_environment": [
    "PROJECT_ROOT",
    "ARTIFACT_ROOT",
    "MODEL_ROOT",
    "DATA_ROOT",
    "VENV_ROOT",
    "DATABASE_URL",
    "GPU_IDS"
  ],
  "commands": [
    {"name": "git", "required": true},
    {"name": "psql", "required": true},
    {"name": "nvidia-smi", "required": true},
    {"name": "nvcc", "required": false}
  ],
  "paths": [
    {"env": "PROJECT_ROOT", "required": true},
    {"env": "VENV_ROOT", "required": false}
  ],
  "disk": {"root_env": "ARTIFACT_ROOT", "minimum_free_gib": 10},
  "gpu": {"required": true, "minimum_count": 1, "minimum_memory_mib": 8000}
}
