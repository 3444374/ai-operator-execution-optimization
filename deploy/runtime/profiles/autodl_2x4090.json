{
  "schema_version": 1,
  "kind": "machine_profile",
  "name": "autodl_2x4090",
  "match": {
    "priority": 100,
    "platforms": ["Linux"],
    "minimum_gpu_count": 2,
    "maximum_gpu_count": 2,
    "minimum_gpu_memory_mib": 20000,
    "gpu_name_regex": "(?i)4090"
  },
  "platforms": ["Linux"],
  "minimum_python": [3, 10],
  "minimum_cpu_slots": 10,
  "required_environment": [
    "PROJECT_ROOT",
    "ARTIFACT_ROOT",
    "MODEL_ROOT",
    "DATA_ROOT",
    "VENV_ROOT",
    "GPU_IDS"
  ],
  "commands": [
    {"name": "git", "required": true},
    {"name": "psql", "required": true, "groups": ["database", "sql-readers"]},
    {"name": "nvidia-smi", "required": true},
    {"name": "nvcc", "required": false}
  ],
  "paths": [
    {"env": "PROJECT_ROOT", "required": true},
    {"env": "VENV_ROOT", "required": false}
  ],
  "disk": {"root_env": "ARTIFACT_ROOT", "minimum_free_gib": 20},
  "gpu": {"required": true, "minimum_count": 2, "minimum_memory_mib": 20000}
}
