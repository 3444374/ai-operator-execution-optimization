# Copy outside the Git repository and adapt only this machine-local file.
PROJECT_ROOT=/srv/ai-operator
ARTIFACT_ROOT=/srv/ai-operator-artifacts
MODEL_ROOT=/srv/ai-operator-assets/models
DATA_ROOT=/srv/ai-operator-assets/data
VENV_ROOT=/srv/ai-operator-assets/venvs
HF_HOME=/srv/ai-operator-assets/huggingface

DRIVER_PYTHON=${VENV_ROOT}/driver/bin/python
VLLM_VENV=${VENV_ROOT}/vllm
VLLM_LOG_DIR=${ARTIFACT_ROOT}/vllm-logs

MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
MODEL_PATH=${MODEL_ROOT}/Qwen2.5-1.5B-Instruct
COMPLETION_MODEL=qwen2.5-1.5b
IMAGE_MODEL_ID=openai/clip-vit-base-patch32
IMAGE_MODEL_PATH=${MODEL_ROOT}/clip-vit-base-patch32

GPU_IDS=0
PORTS=8000
VLLM_HOST=127.0.0.1
COMPLETION_ENDPOINT_URL_0=http://127.0.0.1:8000/v1/completions
COMPLETION_CHAT_ENDPOINT_URL_0=http://127.0.0.1:8000/v1/chat/completions
COMPLETION_ENDPOINT_URLS=${COMPLETION_ENDPOINT_URL_0}
COMPLETION_CHAT_ENDPOINT_URLS=${COMPLETION_CHAT_ENDPOINT_URL_0}
MODEL_METRICS_URLS=http://127.0.0.1:8000/metrics
RAY_ADDRESS=127.0.0.1:6380
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_operator

# Keep 0 for smoke when the precision-specific peak is not yet verified.
# Formal MFU reporting must replace this with the documented value for this GPU.
GPU_PEAK_TFLOPS=0
MFU_PRECISION=bf16_dense_fp32_accumulate
