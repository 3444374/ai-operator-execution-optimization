{
  "schema_version": 1,
  "experiment_id": "dual_gpu_text_native_baseline_formal",
  "formal": true,
  "execution_status": "contract_only_until_calibration_is_frozen",
  "completion_protocol": "chat_completions",
  "rows_total": 2048,
  "minimum_measurement_seconds": 60,
  "warmup_repeats": 1,
  "formal_repeats": 3,
  "schedule": "balanced_interleaved_random_order",
  "service": {
    "prefix_caching": "enabled",
    "max_num_seqs": 256,
    "max_num_batched_tokens": 8192
  },
  "endpoint_urls": [
    "${COMPLETION_CHAT_ENDPOINT_URL_0}",
    "${COMPLETION_CHAT_ENDPOINT_URL_1}"
  ],
  "model": "${COMPLETION_MODEL}",
  "tokenizer": "${MODEL_PATH}",
  "manifest": "${TEXT_NATIVE_FORMAL_MANIFEST}",
  "output_root": "${ARTIFACT_ROOT}/text_native_baseline_formal_REPLACE_ME",
  "arms": [
    {
      "id": "vllm_bench",
      "adapter": "vllm_bench",
      "comparison_role": "service_ceiling",
      "configuration": "freeze_from_independent_calibration"
    },
    {
      "id": "bounded_http",
      "adapter": "bounded_http",
      "comparison_role": "direct_client_control",
      "configuration": "freeze_from_independent_calibration"
    },
    {
      "id": "daft_native",
      "adapter": "daft_native",
      "comparison_role": "framework_native_baseline",
      "configuration": "vendor_default_prompt_api"
    },
    {
      "id": "daft_ray",
      "adapter": "daft_ray",
      "comparison_role": "framework_native_baseline",
      "ray_address": "${RAY_ADDRESS}",
      "configuration": "vendor_default_prompt_api"
    },
    {
      "id": "ray_data_http",
      "adapter": "ray_data_http",
      "comparison_role": "framework_native_baseline",
      "ray_address": "${RAY_ADDRESS}",
      "configuration": "freeze_batch_and_concurrency_from_independent_calibration"
    }
  ],
  "optional_arms": [
    {
      "id": "duckdb_ai",
      "adapter": "duckdb_ai",
      "comparison_role": "database_product_native_baseline",
      "python_executable": "${DUCKDB_AI_PYTHON}",
      "configuration": "freeze_extension_concurrency_from_independent_calibration",
      "requires": "passing_duckdb_ai_bounded_output_semantic_gate_and_same_bounded_output_manifest",
      "fixed": {
        "response_cache": false,
        "prompt_cache_hints": false,
        "retry_count": 0,
        "min_request_interval_ms": 0
      }
    },
    {
      "id": "oceanbase_ai_complete",
      "adapter": "oceanbase",
      "comparison_role": "database_product_native_baseline",
      "requires": "successful_privileged_or_vm_capability_gate"
    }
  ],
  "required_metrics": [
    "jct_s",
    "service_prompt_tokens_per_s",
    "service_generation_tokens_per_s",
    "service_total_tokens_per_s",
    "request_throughput",
    "latency_p50_p95_p99_when_request_level_observable",
    "slo_goodput_when_request_level_observable",
    "first_output_or_ttft_when_observable",
    "vllm_running_waiting_kv_cache",
    "vllm_prefix_cache_queries_hits_and_hit_rate",
    "gpu_utilization_memory_power_energy_mfu",
    "host_cpu_memory_network_io",
    "worker_actor_task_counts",
    "failures_retries_exactly_once"
  ],
  "hard_gates": {
    "provenance_fields_present": true,
    "native_arms_have_no_project_scheduler": true,
    "same_manifest_model_protocol_service_config": true,
    "exactly_once": true,
    "failed_rows": 0,
    "worker_failures": 0,
    "both_endpoints_used": true,
    "service_counter_consistency": true,
    "final_vllm_queues_empty": true,
    "formal_duration_at_least_seconds": 60
  }
}
