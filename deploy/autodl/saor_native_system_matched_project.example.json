      "project_static_k_per_endpoint": "${PROJECT_STATIC_K_PER_ENDPOINT}",
      "project_active_work_per_endpoint": "${PROJECT_ACTIVE_WORK_PER_ENDPOINT}",
      "project_actor_workers_per_endpoint": "${PROJECT_ACTOR_WORKERS_PER_ENDPOINT}",
      "project_ray_actor_max_concurrency": "${PROJECT_RAY_ACTOR_MAX_CONCURRENCY}",
      "project_ray_worker_num_cpus": "${PROJECT_RAY_WORKER_NUM_CPUS}"
    }
  },
  "saor_release_control": {
    "entitlement_weight": 1.0,
    "queue_weight": 0.0,
    "fairness_weight": 1.0,
    "slo_weight": 0.0
