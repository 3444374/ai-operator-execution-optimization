    "--ray-worker-num-cpus", "${PROJECT_RAY_WORKER_NUM_CPUS}",
    "--model-backend", "compatible_http",
    "--completion-http-transport", "httpx_async",
    "--completion-http-keepalive-expiry-s", "${COMPLETION_HTTP_KEEPALIVE_EXPIRY_S}",
    "--completion-model", "${COMPLETION_MODEL}",
    "--completion-protocol", "${COMPLETION_PROTOCOL}",
    "--completion-max-tokens", "${COMPLETION_MAX_TOKENS}",
    "--completion-prompt-format", "raw",
    "--completion-temperature", "0",
    "--completion-return-token-ids",
    "--output-cost-mode", "fixed_output_cap",
    "--endpoint-routing", "manifest_pinned",
    "--completion-endpoint-urls", "${COMPLETION_ENDPOINT_URLS}",
    "--model-metrics-urls", "${MODEL_METRICS_URLS}",
    "--organizer", "${SAOR_ORGANIZER}",
    "--batching-policy", "token_budget",
    "--token-budget", "${PROJECT_TOKEN_BUDGET}",
    "--token-budget-policy", "static",
    "--writeback-mode", "none"
