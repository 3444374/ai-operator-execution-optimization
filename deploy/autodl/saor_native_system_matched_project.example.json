    },
    {
      "scenario_id": "project_bounded_ready_fifo", "policy": "shared_fifo",
      "ready_observation_contract": "bounded_concrete_pre_registration",
      "job_count": 2, "rows_per_jobs": [512, 512], "arrival_offsets_s": [0, 5],
      "request_manifests": ["${SAOR_MATCHED_JOB0_MANIFEST}", "${SAOR_MATCHED_JOB1_MANIFEST}"]
    },
    {
      "scenario_id": "project_bounded_ready_drr", "policy": "shared_drr",
      "ready_observation_contract": "bounded_concrete_pre_registration",
      "job_count": 2, "rows_per_jobs": [512, 512], "arrival_offsets_s": [0, 5],
      "request_manifests": ["${SAOR_MATCHED_JOB0_MANIFEST}", "${SAOR_MATCHED_JOB1_MANIFEST}"]
    },
    {
      "scenario_id": "project_bounded_ready_vtc_style", "policy": "external_vtc",
      "ready_observation_contract": "bounded_concrete_pre_registration",
      "job_count": 2, "rows_per_jobs": [512, 512], "arrival_offsets_s": [0, 5],
      "request_manifests": ["${SAOR_MATCHED_JOB0_MANIFEST}", "${SAOR_MATCHED_JOB1_MANIFEST}"]
    },
    {
      "scenario_id": "project_bounded_ready_saor_0125we",
      "policy": "saor_bounded_ready",
      "ready_observation_contract": "bounded_concrete_pre_registration",
      "job_count": 2, "rows_per_jobs": [512, 512], "arrival_offsets_s": [0, 5],
      "priorities": [0, 1], "slo_targets_s": [null, 30],
      "priority_windows_s": [null, 30],
      "debt_cap_fractions": [0.125, null],
      "request_manifests": ["${SAOR_MATCHED_JOB0_MANIFEST}", "${SAOR_MATCHED_JOB1_MANIFEST}"]
    }
  ]
