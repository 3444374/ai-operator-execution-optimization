{
  "schema_version": 1,
  "formal": true,
  "experiment_id": "opening_image_native_fourjob_20260809",
  "output_root": "${IMAGE_NATIVE_FOURJOB_OUTPUT_ROOT}",
  "python_executable": "${IMAGE_DRIVER_PYTHON}",
  "image_runner": "code/scripts/experiments/run_image_clip_e2e.py",
  "ray_address": "${RAY_ADDRESS}",
  "job_manifest": "${IMAGE_FOURJOB_MANIFEST}",
  "launch_lead_s": 2,
  "ready_timeout_s": 900,
  "process_timeout_s": 1800,
  "gpu_sample_interval_s": 0.5,
  "cpu_sample_interval_s": 0.25,
  "warmup_repeats": 1,
  "formal_repeats": 3,
  "schedule_seed": 20260809,
  "minimum_measurement_seconds": 1,
  "common_args": [
    "--model", "${IMAGE_MODEL_PATH}",
    "--processor", "${IMAGE_MODEL_PATH}",
    "--warmup-rows", "64",
    "--batch-size", "64",
    "--gpu-workers", "2",
    "--source-shards", "4",
    "--source-cpu-threads", "4",
    "--torch-intraop-threads", "1",
    "--torch-interop-threads", "1",
    "--dtype", "float16",
    "--model-flops-per-image", "${IMAGE_MODEL_FLOPS_PER_IMAGE}",
    "--gpu-peak-flops-per-s", "${IMAGE_GPU_PEAK_FLOPS_PER_S}",
    "--embedding-output-contract", "l2_normalized"
  ],
  "arms": [
    {"id": "daft_builtin_single_short", "adapter": "daft_builtin_embed", "args": ["--cpu-workers", "4"], "jobs": ["short"]},
    {"id": "daft_builtin_single_long1", "adapter": "daft_builtin_embed", "args": ["--cpu-workers", "4"], "jobs": ["long1"]},
    {"id": "daft_builtin_single_long2", "adapter": "daft_builtin_embed", "args": ["--cpu-workers", "4"], "jobs": ["long2"]},
    {"id": "daft_builtin_single_long3", "adapter": "daft_builtin_embed", "args": ["--cpu-workers", "4"], "jobs": ["long3"]},
    {"id": "daft_builtin_fourjob", "adapter": "daft_builtin_embed", "args": ["--cpu-workers", "4"], "jobs": ["short", "long1", "long2", "long3"]},
    {"id": "ray_data_single_short", "adapter": "ray_data_staged", "args": ["--cpu-workers", "16", "--ray-data-autoscaling-actor-pools"], "jobs": ["short"]},
    {"id": "ray_data_single_long1", "adapter": "ray_data_staged", "args": ["--cpu-workers", "16", "--ray-data-autoscaling-actor-pools"], "jobs": ["long1"]},
    {"id": "ray_data_single_long2", "adapter": "ray_data_staged", "args": ["--cpu-workers", "16", "--ray-data-autoscaling-actor-pools"], "jobs": ["long2"]},
    {"id": "ray_data_single_long3", "adapter": "ray_data_staged", "args": ["--cpu-workers", "16", "--ray-data-autoscaling-actor-pools"], "jobs": ["long3"]},
    {"id": "ray_data_fourjob", "adapter": "ray_data_staged", "args": ["--cpu-workers", "16", "--ray-data-autoscaling-actor-pools"], "jobs": ["short", "long1", "long2", "long3"]}
  ]
}
