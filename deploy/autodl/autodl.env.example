# Copy outside the Git repository before editing:
#   cp deploy/autodl/autodl.env.example /root/autodl-tmp/ai-operator-runtime.env

# Shared storage and Python environment.
VLLM_VENV=/root/autodl-tmp/venvs/vllm-4090
HF_HOME=/root/autodl-tmp/huggingface
VLLM_LOG_DIR=/root/autodl-tmp/vllm_logs
# Keep FlashInfer JIT's compiler and headers on the same installed toolkit.
# The pip environment can contain a newer nvcc beside Torch's CUDA 13.0 headers.
CUDA_HOME=/usr/local/cuda-13.0
CUDA_NVCC_BIN=/usr/local/cuda-13.0/bin

# Model download and serving identity. Change only these values to switch model.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_DIR=/root/autodl-tmp/models/Qwen2.5-7B-Instruct
MODEL_PATH=/root/autodl-tmp/models/Qwen2.5-7B-Instruct
COMPLETION_MODEL=qwen2.5-7b

# One independently addressed vLLM endpoint per GPU.
GPU_IDS=0,1
PORTS=8000,8001
VLLM_HOST=127.0.0.1
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_MAX_NUM_SEQS=256
VLLM_EXTRA_ARGS="--no-enable-prefix-caching --enable-mfu-metrics --max-num-batched-tokens 8192 --max-num-seqs 256"

# The launcher never kills arbitrary vLLM processes. Set this to 1 only when
# restarting endpoints previously launched by the same script and PID files.
STOP_MANAGED_ENDPOINTS=0

# Profiler/scenario-runner settings.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_operator
COMPLETION_ENDPOINT_URLS=http://127.0.0.1:8000/v1/completions,http://127.0.0.1:8001/v1/completions
COMPLETION_CHAT_ENDPOINT_URLS=http://127.0.0.1:8000/v1/chat/completions,http://127.0.0.1:8001/v1/chat/completions
MODEL_METRICS_URLS=http://127.0.0.1:8000/metrics,http://127.0.0.1:8001/metrics
SINGLE_COMPLETION_ENDPOINT_URL=http://127.0.0.1:8000/v1/completions
SINGLE_MODEL_METRICS_URL=http://127.0.0.1:8000/metrics
SINGLE_ENDPOINT_GPU_ID=0
RAY_ADDRESS=127.0.0.1:6380
SOURCE_WORKLOAD_NAME=sharegpt_burstgpt
SOURCE_MAX_PROMPT_TOKENS=1500
COMPLETION_MAX_TOKENS=256
COMPLETION_PROMPT_FORMAT=chatml
TOKEN_BUDGET=8192
# Fixed non-treatment organizer boundary for the request-level active-work probe.
CAPACITY_PROBE_TOKEN_BUDGET=32768
# Set from the work-normalized token-budget curve before comparing organization policies.
BEST_TOKEN_BUDGET=8192
# Safe dynamic actions must come from the measured static capacity curve.
TOKEN_BUDGET_CANDIDATES=2048,4096,8192,16384
# Calibrate this first with the request-level endpoint active-work sweep. Keep
# it at least as large as the largest token-budget arm in the next curve.
ACTIVE_WORK_PER_ENDPOINT=65536
# Frozen same-condition request manifests. Populate these paths only after
# exporting and verifying immutable JSONL evidence for the intended split.
PROJECT_CALIBRATION_REQUEST_MANIFEST=
PROJECT_FORMAL_REQUEST_MANIFEST=
# Select these from the 512-row project calibration before formal execution.
PROJECT_STATIC_K_PER_ENDPOINT=256
PROJECT_ACTIVE_WORK_PER_ENDPOINT=65536
# Use a workload-relevant SLO; 300000 ms made the completed curve non-discriminative.
REQUEST_SLO_MS=30000
GPU_PEAK_TFLOPS=165
MFU_PRECISION=bf16_dense_fp32_accumulate
