# Copy outside Git and adapt to the current machine and task.
# Shared storage; keep model/data/cache/output on the persistent data disk.
PROJECT_ROOT=/root/autodl-tmp/ai-operator
ARTIFACT_ROOT=/root/autodl-tmp/experiment-artifacts
MODEL_ROOT=/root/autodl-tmp/models
DATA_ROOT=${PROJECT_ROOT}/data/raw
VENV_ROOT=/root/autodl-tmp/venvs
DRIVER_PYTHON=${VENV_ROOT}/driver/bin/python
VLLM_VENV=${VENV_ROOT}/vllm-4090
HF_HOME=/root/autodl-tmp/huggingface
VLLM_LOG_DIR=${ARTIFACT_ROOT}/vllm-logs

# Example CUDA toolkit pairing for this profile; verify the installed toolkit.
CUDA_HOME=/usr/local/cuda-13.0
CUDA_NVCC_BIN=/usr/local/cuda-13.0/bin

# Example model identity; each task must bind its actual model and tokenizer.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_DIR=${MODEL_ROOT}/Qwen2.5-7B-Instruct
MODEL_PATH=${MODEL_DIR}
COMPLETION_MODEL=qwen2.5-7b
IMAGE_MODEL_ID=openai/clip-vit-base-patch32
IMAGE_MODEL_PATH=${MODEL_ROOT}/clip-vit-base-patch32

# Optional independently managed HTTP endpoint. Local IPC queries use their owner.
# Values below are examples, not measured capacity or task admission defaults.
GPU_IDS=0
PORTS=8000
VLLM_HOST=127.0.0.1
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_EXTRA_ARGS=
STOP_MANAGED_ENDPOINTS=0
COMPLETION_ENDPOINT_URLS=http://127.0.0.1:8000/v1/completions
COMPLETION_CHAT_ENDPOINT_URLS=http://127.0.0.1:8000/v1/chat/completions
MODEL_METRICS_URLS=http://127.0.0.1:8000/metrics
RAY_ADDRESS=127.0.0.1:6380

# Query/session configuration belongs to the selected SemBench entry.
# Exact old SAOR/ShareGPT/K/W environment values remain in the recipe archive.
