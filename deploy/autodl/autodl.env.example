# Copy outside the Git repository before editing:
#   cp deploy/autodl/autodl.env.example /root/autodl-tmp/ai-operator-runtime.env

# Shared storage and Python environment. Only the five roots below are
# machine-layout decisions; derived paths should not repeat /root/autodl-tmp.
PROJECT_ROOT=/root/autodl-tmp/ai-operator
ARTIFACT_ROOT=/root/autodl-tmp/experiment-artifacts
MODEL_ROOT=/root/autodl-tmp/models
DATA_ROOT=${PROJECT_ROOT}/data/raw
VENV_ROOT=/root/autodl-tmp/venvs
VLLM_VENV=${VENV_ROOT}/vllm-4090
DUCKDB_AI_PYTHON=${VENV_ROOT}/text-baselines/bin/python
HF_HOME=/root/autodl-tmp/huggingface
VLLM_LOG_DIR=/root/autodl-tmp/vllm_logs
# Keep FlashInfer JIT's compiler and headers on the same installed toolkit.
# The pip environment can contain a newer nvcc beside Torch's CUDA 13.0 headers.
CUDA_HOME=/usr/local/cuda-13.0
CUDA_NVCC_BIN=/usr/local/cuda-13.0/bin

# Model download and serving identity. Change only these values to switch model.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_DIR=${MODEL_ROOT}/Qwen2.5-7B-Instruct
MODEL_PATH=${MODEL_ROOT}/Qwen2.5-7B-Instruct
COMPLETION_MODEL=qwen2.5-7b

# Image AI_EMBED track. The Ray actor uses driver Python; vLLM pooling baseline
# uses VLLM_VENV and must run in a separate time slot from the actor experiment.
IMAGE_MODEL_ID=openai/clip-vit-base-patch32
IMAGE_MODEL_PATH=${MODEL_ROOT}/clip-vit-base-patch32
IMAGE_SERVED_MODEL=clip-vit-b32
IMAGE_SOURCE_WORKLOAD_NAME=coco_val2017
IMAGE_DTYPE=float16
IMAGE_NORMALIZE=1
IMAGE_POOLING_PORTS=8100,8101

# One independently addressed vLLM endpoint per GPU.
GPU_IDS=0,1
PORTS=8000,8001
VLLM_HOST=127.0.0.1
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_MAX_NUM_SEQS=256
VLLM_EXTRA_ARGS="--enable-prefix-caching --enable-mfu-metrics --max-num-batched-tokens 8192 --max-num-seqs 256"

# The launcher never kills arbitrary vLLM processes. Set this to 1 only when
# restarting endpoints previously launched by the same script and PID files.
STOP_MANAGED_ENDPOINTS=0

# Profiler/scenario-runner settings.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_operator
COMPLETION_ENDPOINT_URLS=http://127.0.0.1:8000/v1/completions,http://127.0.0.1:8001/v1/completions
COMPLETION_CHAT_ENDPOINT_URLS=http://127.0.0.1:8000/v1/chat/completions,http://127.0.0.1:8001/v1/chat/completions
COMPLETION_ENDPOINT_URL_0=http://127.0.0.1:8000/v1/completions
COMPLETION_ENDPOINT_URL_1=http://127.0.0.1:8001/v1/completions
COMPLETION_CHAT_ENDPOINT_URL_0=http://127.0.0.1:8000/v1/chat/completions
COMPLETION_CHAT_ENDPOINT_URL_1=http://127.0.0.1:8001/v1/chat/completions
COMPLETION_PROTOCOL=completions
MODEL_METRICS_URLS=http://127.0.0.1:8000/metrics,http://127.0.0.1:8001/metrics
ENDPOINT_GPU_IDS=0,1
SINGLE_COMPLETION_ENDPOINT_URL=http://127.0.0.1:8000/v1/completions
SINGLE_MODEL_METRICS_URL=http://127.0.0.1:8000/metrics
SINGLE_ENDPOINT_GPU_ID=0
RAY_ADDRESS=127.0.0.1:6380
SOURCE_WORKLOAD_NAME=sharegpt_burstgpt
SOURCE_MAX_PROMPT_TOKENS=1500
COMPLETION_MAX_TOKENS=256
COMPLETION_PROMPT_FORMAT=chatml
TOKEN_BUDGET=8192
# Fixed non-treatment organizer boundary for the request-level active-work probe.
CAPACITY_PROBE_TOKEN_BUDGET=32768
# Generated by select_strategy_calibration.py; downstream runners verify it
# against STRATEGY_CALIBRATION_SELECTION before touching the model service.
STRATEGY_CALIBRATION_SELECTION=
BEST_TOKEN_BUDGET=
# Safe dynamic actions must come from the measured static capacity curve.
TOKEN_BUDGET_CANDIDATES=2048,4096,8192,16384,32768,49152,65536
# Calibrate this first with the request-level endpoint active-work sweep. Keep
# it at least as large as the largest token-budget arm in the next curve.
ACTIVE_WORK_PER_ENDPOINT=65536
# Frozen same-condition request manifests. Populate these paths only after
# exporting and verifying immutable JSONL evidence for the intended split.
PROJECT_CALIBRATION_REQUEST_MANIFEST=
PROJECT_FORMAL_REQUEST_MANIFEST=
TEXT_NATIVE_FORMAL_MANIFEST=
OFFICIAL_BASELINE_GATE_MANIFEST=
# Dedicated 64-row bounded-output manifest; every row must naturally stop before
# max_tokens so DuckDB ai_try_complete does not turn truncation into an error.
DUCKDB_AI_GATE_MANIFEST=
# Select these from the frozen calibration contract before formal execution.
PROJECT_STATIC_K_PER_ENDPOINT=
PROJECT_ACTIVE_WORK_PER_ENDPOINT=
PROJECT_ACTOR_WORKERS_PER_ENDPOINT=
PROJECT_RAY_ACTOR_MAX_CONCURRENCY=
PROJECT_RAY_WORKER_NUM_CPUS=
# Fixed-envelope SAOR active-set matrix. Values are workload evidence, not
# hard-coded scheduler defaults: export immutable manifests, then copy the
# audited rows/offset and the calibrated shared-credit quantum here.
PROJECT_SHARED_CREDIT_QUANTUM=
SAOR_ACTIVE_SET_WORKLOAD=
SAOR_BULK_MANIFEST=
SAOR_FOREGROUND_MANIFEST=
SAOR_BULK_ROWS=
SAOR_FOREGROUND_ROWS=
SAOR_FOREGROUND_OFFSET_S=
# Replay the manifest's internal arrival timestamps at an explicitly audited
# scale. The readiness gate rejects non-positive scales, excessive effective
# spans, and a foreground offset that cannot overlap the bulk Job.
SAOR_ARRIVAL_TIME_SCALE=
SAOR_MAX_EFFECTIVE_MANIFEST_SPAN_S=
# Require the bulk trace to offer at least this many full work envelopes on
# every endpoint before the foreground Job starts. Use 1.0 for the active-set
# borrow/reclaim/work-conserving-drain formal contract.
SAOR_MIN_PRE_FOREGROUND_WORK_ENVELOPES=1.0
# Use a workload-relevant SLO; 300000 ms made the completed curve non-discriminative.
REQUEST_SLO_MS=30000
GPU_PEAK_TFLOPS=165
MFU_PRECISION=bf16_dense_fp32_accumulate
