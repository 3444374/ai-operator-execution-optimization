    "${DATABASE_URL}",
    "--total-rows",
    "256",
    "--db-fetch-rows",
    "256",
    "--source-max-prompt-tokens",
    "${SOURCE_MAX_PROMPT_TOKENS}",
    "--operator",
    "ai_complete",
    "--executor",
    "ray_actor",
    "--model-backend",
    "compatible_http",
    "--completion-endpoint-urls",
    "${COMPLETION_ENDPOINT_URLS}",
    "--completion-model",
    "${COMPLETION_MODEL}",
    "--completion-protocol",
    "completions",
    "--completion-http-transport",
    "httpx_async",
    "--completion-max-tokens",
    "${COMPLETION_MAX_TOKENS}",
    "--completion-return-token-ids",
    "--completion-prompt-format",
    "raw",
    "--completion-temperature",
    "0",
    "--completion-request-timeout-s",
    "300",
    "--model-metrics-urls",
    "${MODEL_METRICS_URLS}",
    "--endpoint-gpu-ids",
    "0,1",
    "--source-workload-name",
    "${SOURCE_WORKLOAD_NAME}",
    "--source-order",
    "arrival_time",
    "--data-source",
    "daft_postgres",
    "--organizer",
    "daft",
    "--organizer-partition-mode",
    "none",
    "--daft-runner",
    "native",
    "--batching-policy",
    "token_budget",
    "--token-budget",
    "${BEST_TOKEN_BUDGET}",
    "--ray-batch-rows",
    "64",
    "--output-cost-mode",
    "fixed_output_cap",
