{
  "schema_version": 1,
  "experiment_id": "dual_gpu_endpoint_adaptive_gate",
  "seed": 20260730,
  "service_metadata": {
    "vllm_version": "0.25.1",
    "enforce_eager": false,
    "compilation_mode": "default",
    "chunked_prefill": true,
    "max_num_batched_tokens": "${VLLM_MAX_NUM_BATCHED_TOKENS}",
    "max_num_seqs": "${VLLM_MAX_NUM_SEQS}",
