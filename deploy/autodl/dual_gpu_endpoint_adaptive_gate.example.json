    "${COMPLETION_MODEL}",
    "--cost-tokenizer-id",
    "${COMPLETION_MODEL}",
    "--actor-workers-per-endpoint",
    "${PROJECT_ACTOR_WORKERS_PER_ENDPOINT}",
    "--ray-actor-max-concurrency",
    "${PROJECT_RAY_ACTOR_MAX_CONCURRENCY}",
    "--ray-worker-num-cpus",
    "${PROJECT_RAY_WORKER_NUM_CPUS}",
    "--arrival-replay",
    "--arrival-time-scale",
    "0.001",
    "--submission-granularity",
    "batch",
    "--admission-scope",
    "per_endpoint",
    "--max-inflight",
    "256",
    "--endpoint-routing",
    "least_queued",
    "--flush-policy",
    "fixed_timeout",
    "--flush-timeout-ms",
    "50",
    "--flush-max-wait-ms",
    "50",
    "--writeback-mode",
    "none",
    "--request-slo-ms",
    "${REQUEST_SLO_MS}",
    "--resource-sample-interval-s",
