{
  "schema_version": 1,
  "experiment_id": "saor_native_system_matched_native",
  "formal": true,
  "output_root": "${SAOR_MATRIX_OUTPUT_ROOT}/native",
  "endpoint_urls": [
    "${COMPLETION_CHAT_ENDPOINT_URL_0}",
    "${COMPLETION_CHAT_ENDPOINT_URL_1}"
  ],
  "endpoint_ids": ["endpoint-0", "endpoint-1"],
  "model": "${COMPLETION_MODEL}",
  "service_signature": {
    "model": "${COMPLETION_MODEL}",
    "service": "${VLLM_VERSION}"
  },
  "protocol": "${COMPLETION_PROTOCOL}",
  "output_cap": "${COMPLETION_MAX_TOKENS}",
  "organizer": "native_framework_owned",
  "api_key_env": null,
  "service": {
    "prefix_caching": "enabled",
    "max_num_seqs": 256,
    "max_num_batched_tokens": 8192
  },
  "idle_timeout_s": 300,
  "launch_lead_s": 2,
  "warmup_repeats": 1,
  "formal_repeats": 3,
  "schedule_seed": 20260813,
  "endpoint_work_skew_max": 0.02,
  "minimum_measurement_seconds": 60,
  "source": {
    "kind": "timed_postgres_manifest",
    "database_url": "${DATABASE_URL}",
    "workload_name": "${SAOR_MATCHED_WORKLOAD}"
  },
  "job_internal_arrival_contract": "eager",
  "arms": [
    {
      "id": "daft_native", "adapter": "daft_native",
      "python_executable": "${TEXT_BASELINES_PYTHON}",
      "concurrency_per_endpoint": 1, "batch_size": 1,
      "timeout_s": 300, "process_timeout_s": 360, "ray_address": null,
      "jobs": [
        {"id": "job0", "manifest": "${SAOR_MATCHED_JOB0_MANIFEST}", "offset_s": 0},
        {"id": "job1", "manifest": "${SAOR_MATCHED_JOB1_MANIFEST}", "offset_s": 5}
      ]
    },
    {
      "id": "daft_ray", "adapter": "daft_ray",
      "python_executable": "${TEXT_BASELINES_PYTHON}",
      "concurrency_per_endpoint": 1, "batch_size": 1,
      "timeout_s": 300, "process_timeout_s": 360,
      "ray_address": "${RAY_ADDRESS}",
      "jobs": [
        {"id": "job0", "manifest": "${SAOR_MATCHED_JOB0_MANIFEST}", "offset_s": 0},
        {"id": "job1", "manifest": "${SAOR_MATCHED_JOB1_MANIFEST}", "offset_s": 5}
      ]
    },
    {
      "id": "ray_data_http", "adapter": "ray_data_http",
      "python_executable": "${TEXT_BASELINES_PYTHON}",
      "concurrency_per_endpoint": 8, "batch_size": 16,
      "timeout_s": 300, "process_timeout_s": 360,
      "ray_address": "${RAY_ADDRESS}",
      "jobs": [
        {"id": "job0", "manifest": "${SAOR_MATCHED_JOB0_MANIFEST}", "offset_s": 0},
        {"id": "job1", "manifest": "${SAOR_MATCHED_JOB1_MANIFEST}", "offset_s": 5}
      ]
    }
  ]
}
