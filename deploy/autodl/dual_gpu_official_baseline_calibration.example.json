{
  "schema_version": 2,
  "experiment_id": "dual_gpu_text_comparison_calibration",
  "formal": false,
  "requires_passing_gate": true,
  "completion_protocol": "chat_completions",
  "calibration_rows": 512,
  "held_out_formal_rows": 4096,
  "minimum_formal_measurement_seconds": 60,
  "arms": {
    "vllm_bench": {
      "comparison_role": "service_ceiling",
      "grid": {
        "concurrency_per_endpoint": [32, 64, 128, 256]
      }
    },
    "bounded_http": {
      "comparison_role": "direct_client_control",
      "grid": {
        "concurrency_per_endpoint": [32, 64, 128, 256]
      }
    },
    "daft_native": {
      "comparison_role": "framework_native_baseline",
      "grid": {},
      "fixed": {
        "api": "daft.functions.prompt",
        "runner": "native"
      },
      "note": "The public prompt adapter exposes no partition_count knob; do not invent one."
    },
    "daft_ray": {
      "comparison_role": "framework_native_baseline",
      "grid": {},
      "fixed": {
        "api": "daft.functions.prompt",
        "runner": "ray",
        "ray_address": "127.0.0.1:6380"
      },
      "note": "Daft owns batching and task scheduling in this native arm."
    },
    "ray_data_http": {
      "comparison_role": "framework_native_baseline",
      "grid": {
        "batch_size": [1, 16, 32, 64],
        "concurrency_per_endpoint": [1, 2, 4, 8, 16]
      },
      "fixed": {
        "ray_address": "127.0.0.1:6380",
        "actor_pool_shape": "fixed_n_n"
      }
    },
    "oceanbase": {
      "comparison_role": "database_product_native_baseline",
      "grid": {
        "parallel_degree": [1, 2, 4, 8]
      },
      "requires": "privileged_or_vm_capability_gate"
    }
  },
  "selection_rule": {
    "per_arm_independent_calibration": true,
    "primary": "highest_service_total_tokens_per_s_under_quality_and_slo_guards",
    "tie_break": "smallest_resource_point_within_3pct_of_peak",
    "required": [
      "zero_incidents",
      "exactly_once",
      "service_counter_consistency",
      "final_vllm_queues_empty",
      "repeat_cv_le_0.05"
    ]
  },
  "prohibited_factors": [
    "project_credit_or_router_inside_native_arms",
    "unwired_partition_count",
    "cross_protocol_ranking",
    "per_workload_post_hoc_retuning_in_formal"
  ]
}
