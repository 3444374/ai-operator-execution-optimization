# Frozen matched-matrix environment for the 2x4090, Qwen2.5-7B-Instruct,
# ShareGPT two-Job native-system matched contract (manifest frozen 2026-08-19).
#
# This file contains no credentials. Copy it outside Git and source the
# machine runtime env first. It is evidence-bound experiment configuration,
# not a scheduler default and not reusable after the hardware/model/protocol/
# workload signature changes.

export PROJECT_ROOT="${PROJECT_ROOT:-/root/autodl-tmp/ai-operator}"
export ARTIFACT_ROOT="${ARTIFACT_ROOT:-/root/autodl-tmp/experiment-artifacts}"
export AI_OPERATOR_ENV_FILE="${AI_OPERATOR_ENV_FILE:-/root/autodl-tmp/ai-operator-runtime.env}"

export VLLM_VERSION=0.25.1
export MODEL_PATH="${MODEL_ROOT}/Qwen2.5-7B-Instruct"
export VLLM_DTYPE=bfloat16
export VLLM_MAX_MODEL_LEN=8192
export VLLM_GPU_MEMORY_UTILIZATION=0.9
export VLLM_MAX_NUM_BATCHED_TOKENS=8192
export VLLM_MAX_NUM_SEQS=256
export VLLM_EXTRA_ARGS="--enable-prefix-caching --enable-chunked-prefill --enable-mfu-metrics --max-num-batched-tokens 8192 --max-num-seqs 256"

# Frozen two-Job matched manifests (Job0=long/bulk, Job1=short/foreground).
# Full prompts remain outside Git because workload text may contain personal data.
# The runner verifies the two per-Job SHA/512-row bindings and their byte-for-byte
# concatenation against the combined SHA before acquiring the execution lease.
export SAOR_MATCHED_JOB0_MANIFEST="${ARTIFACT_ROOT}/opening_multijob_manifests_20260808_work_balanced/long_512.jsonl"
export SAOR_MATCHED_JOB1_MANIFEST="${ARTIFACT_ROOT}/opening_multijob_manifests_20260808_work_balanced/short_512.jsonl"
export SAOR_MATCHED_COMBINED_MANIFEST="${ARTIFACT_ROOT}/opening_multijob_manifests_20260808_work_balanced/matched_long_short_1024.jsonl"

# PostgreSQL timed source. sharegpt_multiturn holds the 2048-row ShareGPT slice
# the 2026-08-08 manifests were built from; row_offset pins the timed source
# window to the manifest doc_id range (verify on-server: ORDER BY doc_id index).
export SAOR_MATCHED_WORKLOAD=sharegpt_multiturn
export SAOR_MATCHED_ROW_OFFSET=0

# Project-only Daft data-engine organizer. Native arms use the literal
# `native_framework_owned` identity and never consume this value. The Project
# batching strategy is frozen separately below.
export SAOR_ORGANIZER=daft

# Fresh per-arm output roots (all under one exclusive matrix root is created by
# the runner; these are per-arm subroots inside the matrix root).
export SAOR_MATRIX_OUTPUT_ROOT="${ARTIFACT_ROOT}/saor_native_system_matched_matrix_20260819"
export SAOR_DAFT_NATIVE_OUTPUT_ROOT="${SAOR_MATRIX_OUTPUT_ROOT}/daft_native"
export SAOR_DAFT_RAY_OUTPUT_ROOT="${SAOR_MATRIX_OUTPUT_ROOT}/daft_ray"
export SAOR_RAY_DATA_HTTP_OUTPUT_ROOT="${SAOR_MATRIX_OUTPUT_ROOT}/ray_data_http"
export SAOR_PROJECT_FROZEN_STATIC_OUTPUT_ROOT="${SAOR_MATRIX_OUTPUT_ROOT}/project_frozen_static"
export SAOR_PROJECT_SAOR_OUTPUT_ROOT="${SAOR_MATRIX_OUTPUT_ROOT}/project_bounded_ready_saor_0125we"

# Frozen MFU denominator identity. The five-arm summary still reports MFU as
# unavailable until every system has a trustworthy common FLOP numerator.
export GPU_PEAK_TFLOPS=165
export MFU_PRECISION=bf16_dense_fp32_accumulate

# Project executor calibration contract (SHA256 55c09b953017...).
# selection: token-budget6144 / K128 / W65536 / actors8 / concurrency32 /
# cpus0.25 (frozen 2026-08-08).
export SAOR_MATRIX_CALIBRATION="${PROJECT_ROOT}/experiments/results/state_aware_work_unit/saor_native_system_matched_calibration_20260819/project_frozen_selection_20260808.json"

# Project executor envelope values (must equal SAOR_MATRIX_CALIBRATION selection).
export PROJECT_STATIC_K_PER_ENDPOINT=128
export PROJECT_ACTIVE_WORK_PER_ENDPOINT=65536
export PROJECT_TOKEN_BUDGET=6144
export PROJECT_ACTOR_WORKERS_PER_ENDPOINT=8
export PROJECT_RAY_ACTOR_MAX_CONCURRENCY=32
export PROJECT_RAY_WORKER_NUM_CPUS=0.25
export PROJECT_READY_BYTES=67108864
export PROJECT_SHARED_CREDIT_QUANTUM=2048

# Protocol values (machine runtime env supplies COMPLETION_MODEL/DATABASE_URL/
# endpoint URLs; chat_completions is the SAOR-line protocol since 2026-08-08).
export COMPLETION_PROTOCOL=chat_completions
export COMPLETION_MAX_TOKENS=256
