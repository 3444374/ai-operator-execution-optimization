        <mxCell id="cost_estimator" value="&lt;b&gt;AI 算子代价估计&lt;/b&gt;&lt;br&gt;输入：工作描述、历史测量&lt;br&gt;输出：预计时间、资源需求" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#E85D04;strokeWidth=1.5;dashed=1;dashPattern=5 4;fontColor=#C2410C;fontFamily=Microsoft YaHei;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="274" width="250" height="72" as="geometry"/></mxCell>
