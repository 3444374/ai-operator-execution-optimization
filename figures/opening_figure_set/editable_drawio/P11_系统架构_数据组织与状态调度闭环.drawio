        <mxCell id="work_descriptor" value="&lt;b&gt;工作描述&lt;/b&gt;&lt;br&gt;WorkDescriptor&lt;br&gt;&lt;br&gt;阶段工作 · 数据局部性&lt;br&gt;作业身份 · 服务信息" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#165DCC;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft YaHei;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="385" width="205" height="146" as="geometry"/></mxCell>
        <mxCell id="organizer" value="&lt;b&gt;数据组织&lt;/b&gt;&lt;br&gt;&lt;br&gt;批次工作量上限 · 均衡&lt;br&gt;局部性 → 批次请求" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#165DCC;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft YaHei;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="385" width="205" height="146" as="geometry"/></mxCell>
        <mxCell id="admission" value="&lt;b&gt;提交控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;运行前测得的请求数&lt;br&gt;和工作量上限&lt;br&gt;结合当前状态调节提交" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E85D04;strokeWidth=2;fontColor=#111827;fontFamily=Microsoft YaHei;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="835" y="385" width="205" height="146" as="geometry"/></mxCell>
