+void PrepareSemLoomDispatch(PreparedCompletion &prepared) {
+    const auto &options = prepared.options;
+    if (prepared.provider.provider != "openai_compatible" || prepared.provider.protocol != "openai_chat") {
+        throw InvalidInputException("SemLoom DuckDB currently requires openai_compatible text completion");
+    }
+    if (ResponseCacheEnabled(options) || RetryCount(options) != 0 || MinRequestIntervalMs(options) != 0 ||
+        TokenLimitPerMinute(options) != 0 || !options.log_endpoint.empty()) {
+        throw InvalidInputException("SemLoom DuckDB requires response cache, retries, pacing, token-rate and remote logging disabled");
+    }
+    prepared.headers = RequestHeaders(prepared.provider, options);
+    for (const auto &header : prepared.headers) { ValidateHttpHeader(header); }
+    prepared.timeout_seconds = TimeoutSeconds(options);
+    prepared.connect_timeout_seconds = ConnectTimeoutSeconds(options, prepared.timeout_seconds);
+    prepared.estimated_tokens = EstimatedCompletionTokens(prepared.prompt, options);
+    prepared.ready_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+CompletionResult FinishCompletion(const PreparedCompletion &prepared, const CompletionResponse &value,
+                                  const std::string &cache_key) {
+    const auto &config = prepared.provider;
+    const auto &prompt = prepared.prompt;
+    const auto &request_options = prepared.options;
+    if (!value.transport_error.empty()) {
+        RecordFailedUsageEvent(config, prompt, request_options, 0, value.transport_error, 0);
+        throw IOException("%s", value.transport_error);
+    }
+    HttpResponse response(value.body, value.status, value.elapsed_ms, -1);
+    response.retries = value.retries;
+    response.cache_hit = value.cache_hit;
@@ -4907,0 +4936,22 @@ CompletionResult Complete(const std::string &prompt, const CompletionOptions &op
+CompletionResult Complete(const std::string &prompt, const CompletionOptions &options) {
+    auto prepared = PrepareCompletion(prompt, options);
+    HttpResponse response;
+    std::string cache_key;
+    try {
+        response = FetchProviderResponse("completion", prepared.provider, prepared.endpoint, prepared.payload,
+                                         prepared.options, EstimatedCompletionTokens(prompt, prepared.options), cache_key);
+    } catch (InterruptException &) {
+        throw;
+    } catch (std::exception &ex) {
+        RecordFailedUsageEvent(prepared.provider, prompt, prepared.options, 0, ex.what(), 0);
+        throw;
+    }
+    CompletionResponse value;
+    value.body = std::move(response.body);
+    value.status = response.status;
+    value.elapsed_ms = response.elapsed_ms;
+    value.retries = response.retries;
+    value.cache_hit = response.cache_hit;
+    return FinishCompletion(prepared, value, cache_key);
+}
