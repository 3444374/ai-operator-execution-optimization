+// SemLoom modification: choose the whole vector batch before ProviderExecutorState.
+bool TryRunSemLoomCompletionJobs(std::vector<ProviderStringJob> &jobs, ClientContext &context) {
+    Value executor;
+    if (!context.TryGetCurrentSetting("duckdb_ai_executor", executor) || executor.IsNull() ||
+        StringValue::Get(executor) == "native") { return false; }
+    if (StringValue::Get(executor) != "semloom") {
+        throw InvalidInputException("duckdb_ai_executor must be native or semloom");
+    }
+    std::vector<duckdb_ai::PreparedCompletion> prepared;
+    std::vector<uint64_t> rows;
+    std::vector<idx_t> job_indices;
+    for (idx_t i = 0; i < jobs.size(); i++) {
+        auto &job = jobs[i];
+        if (job.options.function_name != "ai_complete" && job.options.function_name != "ai_try_complete") {
+            throw InvalidInputException("SemLoom DuckDB currently supports only ai_complete and ai_try_complete");
+        }
+        try {
+            prepared.push_back(duckdb_ai::PrepareCompletion(job.input, job.options));
+        } catch (InterruptException &) {
+            throw;
+        } catch (std::exception &ex) {
+            job.exception = std::current_exception();
+            job.error_message = ex.what();
+            if (job.fail_on_error) { return true; }
+            continue;
+        }
+        // Unsupported execution policies fail the batch before any external request.
+        duckdb_ai::PrepareSemLoomDispatch(prepared.back());
+        rows.push_back(job.row);
+        job_indices.push_back(i);
+    }
+    duckdb_ai::DispatchSemLoomBatch(prepared, rows, [&](uint64_t i, const duckdb_ai::CompletionResponse &response) {
+        auto &job = jobs[job_indices[i]];
+        try {
+            job.output = duckdb_ai::FinishCompletion(prepared[i], response).text;
+            job.completed = true;
+        } catch (InterruptException &) {
+            throw;
+        } catch (std::exception &ex) {
+            job.exception = std::current_exception();
+            job.error_message = ex.what();
+            return job.fail_on_error;
+        }
+        return false;
+    });
+    return true;
+}
