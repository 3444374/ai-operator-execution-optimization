log_format upstream_addr '$remote_addr - [$time_local] "$request" '
                        'status=$status upstream=$upstream_addr rt=$request_time ct=$upstream_connect_time';

upstream vllm_pool {
    server 127.0.0.1:8000;
    server 127.0.0.1:8001;
    keepalive 64;
}

server {
    listen 8500;
    access_log /var/log/nginx/vllm_lb_access.log upstream_addr;

    location / {
        proxy_pass http://vllm_pool;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_next_upstream off;
        add_header X-Upstream-Addr $upstream_addr always;
        proxy_read_timeout 300s;
    }
}
