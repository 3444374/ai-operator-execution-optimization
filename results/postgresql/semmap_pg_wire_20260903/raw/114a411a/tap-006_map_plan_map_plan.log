	DECLARE result text;
	BEGIN
	  BEGIN
	    EXECUTE 'SELECT 1 / 0';
	  EXCEPTION WHEN division_by_zero THEN
	    NULL;
	  END;
	  EXECUTE 'SELECT ''Echo the input.''::text' INTO result;
	  RETURN result;
	END $$;
