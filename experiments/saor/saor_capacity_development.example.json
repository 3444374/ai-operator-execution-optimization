{
  "schema_version": 1,
  "experiment_id": "saor_capacity_development",
  "seed": 20260811,
  "require_complete_service_metadata": true,
  "service_metadata": {
    "vllm_version": "${VLLM_VERSION}",
    "enforce_eager": false,
    "compilation_mode": "default",
    "chunked_prefill": true,
    "max_num_batched_tokens": "${VLLM_MAX_NUM_BATCHED_TOKENS}",
    "max_num_seqs": "${VLLM_MAX_NUM_SEQS}",
    "gpu_memory_utilization": 0.9,
    "prefix_caching": true,
    "mfu_metrics": true
  },
  "warmup_runs_per_scenario": 0,
  "formal_repeats": 1,
  "endpoint_ids": ["endpoint-0", "endpoint-1"],
  "request_limit_per_endpoint": "${PHASE_CHANGE_LOWER_K}",
  "work_limit_per_endpoint": "${PHASE_CHANGE_LOWER_W}",
  "credit_quantum": 512,
  "shared_credit_namespace": "ai-operator-saor-capacity-development",
  "state_aware_control": {
    "request_candidates": ["${PHASE_CHANGE_LOWER_K}", "${PHASE_CHANGE_UPPER_K}"],
    "work_candidates": ["${PHASE_CHANGE_LOWER_W}", "${PHASE_CHANGE_UPPER_W}"],
    "initial_request_limit": "${PHASE_CHANGE_LOWER_K}",
    "fallback_request_limit": "${PHASE_CHANGE_LOWER_K}",
    "fallback_work_limit": "${PHASE_CHANGE_LOWER_W}",
    "target_service_rate_tokens_s_per_endpoint": "${SAOR_GOODPUT_SCALE}",
    "rate_ewma_alpha": "${SAOR_EWMA_ALPHA}",
    "congestion_kv_usage": "${LEGACY_CONGESTION_KV_USAGE}",
    "consecutive_samples": "${LEGACY_CONSECUTIVE_SAMPLES}",
    "increase_consecutive_samples": "${LEGACY_INCREASE_SAMPLES}",
    "cooldown_samples": "${LEGACY_COOLDOWN_SAMPLES}",
    "max_state_age_s": "${SAOR_MAX_STATE_AGE_S}"
  },
  "saor_capacity_control": {
    "arms": [
      {
        "name": "lower",
        "request_limit": "${PHASE_CHANGE_LOWER_K}",
        "work_limit": "${PHASE_CHANGE_LOWER_W}",
        "prior_goodput": "${SAOR_LOWER_PRIOR_GOODPUT}",
        "prior_tail_risk": "${SAOR_LOWER_PRIOR_TAIL_RISK}",
        "prior_energy": 0.0
      },
      {
        "name": "upper",
        "request_limit": "${PHASE_CHANGE_UPPER_K}",
        "work_limit": "${PHASE_CHANGE_UPPER_W}",
        "prior_goodput": "${SAOR_UPPER_PRIOR_GOODPUT}",
        "prior_tail_risk": "${SAOR_UPPER_PRIOR_TAIL_RISK}",
        "prior_energy": 0.0
      }
    ],
    "initial_arm": "lower",
    "fallback_arm": "lower",
    "observation_model": {
      "goodput_field": "service_rate_tokens_s",
      "goodput_scale": "${SAOR_GOODPUT_SCALE}",
      "tail_features": [
        {
          "field": "vllm_waiting",
          "scale": "${SAOR_WAITING_SCALE}",
          "weight": "${SAOR_WAITING_WEIGHT}"
        },
        {
          "field": "vllm_kv_usage",
          "scale": "${SAOR_KV_SCALE}",
          "weight": "${SAOR_KV_WEIGHT}"
        }
      ],
      "energy_features": []
    },
    "ewma_alpha": "${SAOR_EWMA_ALPHA}",
    "queue_work_scale": "${SAOR_QUEUE_WORK_SCALE}",
    "min_dwell_samples": "${SAOR_MIN_DWELL_SAMPLES}",
    "max_state_age_s": "${SAOR_MAX_STATE_AGE_S}",
    "v": "${SAOR_V}",
    "tail_weight": "${SAOR_TAIL_WEIGHT}",
    "energy_weight": 0.0,
    "switch_weight": "${SAOR_SWITCH_WEIGHT}"
  },
  "common_args": [
    "--database-url", "${DATABASE_URL}",
    "--operator", "ai_complete",
    "--executor", "ray_actor",
    "--actor-workers-per-endpoint", "8",
    "--ray-actor-max-concurrency", "32",
    "--ray-worker-num-cpus", "0.25",
    "--model-backend", "compatible_http",
    "--completion-endpoint-urls", "http://127.0.0.1:8000/v1/chat/completions,http://127.0.0.1:8001/v1/chat/completions",
    "--completion-model", "${COMPLETION_MODEL}",
    "--completion-protocol", "chat_completions",
    "--completion-http-transport", "httpx_async",
    "--completion-max-tokens", "${PHASE_CHANGE_OUTPUT_CAP}",
    "--completion-return-token-ids",
    "--completion-ignore-eos",
    "--completion-prompt-format", "raw",
    "--completion-temperature", "0",
    "--completion-request-timeout-s", "180",
    "--model-metrics-urls", "http://127.0.0.1:8000/metrics,http://127.0.0.1:8001/metrics",
    "--endpoint-gpu-ids", "0,1",
    "--source-workload-name", "${PHASE_CHANGE_WORKLOAD}",
    "--source-order", "arrival_time",
    "--data-source", "daft_postgres",
    "--organizer", "daft",
    "--daft-runner", "native",
    "--batching-policy", "token_budget",
    "--token-budget", "6144",
    "--ray-batch-rows", "256",
    "--output-cost-mode", "fixed_output_cap",
    "--cost-model-id", "${COMPLETION_MODEL}",
    "--cost-tokenizer-id", "${MODEL_PATH}",
    "--arrival-replay",
    "--arrival-time-scale", "1.0",
    "--scheduling-policy", "static",
    "--endpoint-routing", "manifest_pinned",
    "--token-budget-policy", "static",
    "--flush-policy", "fixed_timeout",
    "--flush-timeout-ms", "50",
    "--flush-max-wait-ms", "50",
    "--writeback-mode", "none",
    "--request-slo-ms", "30000",
    "--gpu-peak-tflops", "165",
    "--mfu-precision", "bf16_dense_fp32_accumulate"
  ],
  "scenarios": [
    {
      "scenario_id": "capacity_frozen_lower",
      "policy": "shared_drr",
      "job_count": 2,
      "rows_per_jobs": ["${PHASE_CHANGE_CLIENT0_ROWS}", "${PHASE_CHANGE_CLIENT1_ROWS}"],
      "request_manifests": ["${PHASE_CHANGE_CLIENT0_MANIFEST}", "${PHASE_CHANGE_CLIENT1_MANIFEST}"],
      "arrival_offsets_s": ["${PHASE_CHANGE_CLIENT0_OFFSET_S}", "${PHASE_CHANGE_CLIENT1_OFFSET_S}"],
      "request_limit_per_endpoint": "${PHASE_CHANGE_LOWER_K}",
      "work_limit_per_endpoint": "${PHASE_CHANGE_LOWER_W}"
    },
    {
      "scenario_id": "capacity_frozen_upper",
      "policy": "shared_drr",
      "job_count": 2,
      "rows_per_jobs": ["${PHASE_CHANGE_CLIENT0_ROWS}", "${PHASE_CHANGE_CLIENT1_ROWS}"],
      "request_manifests": ["${PHASE_CHANGE_CLIENT0_MANIFEST}", "${PHASE_CHANGE_CLIENT1_MANIFEST}"],
      "arrival_offsets_s": ["${PHASE_CHANGE_CLIENT0_OFFSET_S}", "${PHASE_CHANGE_CLIENT1_OFFSET_S}"],
      "request_limit_per_endpoint": "${PHASE_CHANGE_UPPER_K}",
      "work_limit_per_endpoint": "${PHASE_CHANGE_UPPER_W}"
    },
    {
      "scenario_id": "capacity_legacy_threshold",
      "policy": "state_aware_adaptive",
      "job_count": 2,
      "rows_per_jobs": ["${PHASE_CHANGE_CLIENT0_ROWS}", "${PHASE_CHANGE_CLIENT1_ROWS}"],
      "request_manifests": ["${PHASE_CHANGE_CLIENT0_MANIFEST}", "${PHASE_CHANGE_CLIENT1_MANIFEST}"],
      "arrival_offsets_s": ["${PHASE_CHANGE_CLIENT0_OFFSET_S}", "${PHASE_CHANGE_CLIENT1_OFFSET_S}"]
    },
    {
      "scenario_id": "capacity_saor",
      "policy": "saor_capacity",
      "job_count": 2,
      "rows_per_jobs": ["${PHASE_CHANGE_CLIENT0_ROWS}", "${PHASE_CHANGE_CLIENT1_ROWS}"],
      "request_manifests": ["${PHASE_CHANGE_CLIENT0_MANIFEST}", "${PHASE_CHANGE_CLIENT1_MANIFEST}"],
      "arrival_offsets_s": ["${PHASE_CHANGE_CLIENT0_OFFSET_S}", "${PHASE_CHANGE_CLIENT1_OFFSET_S}"]
    }
  ]
}
