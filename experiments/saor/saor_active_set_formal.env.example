# Frozen formal environment for the 2x4090, Qwen2.5-7B-Instruct,
# ShareGPT long/short active-set contract validated on 2026-08-12.
#
# This file contains no credentials. Copy it outside Git and source the
# machine runtime env first. It is evidence-bound experiment configuration,
# not a scheduler default and not reusable after the hardware/model/protocol/
# workload signature changes.

export PROJECT_ROOT="${PROJECT_ROOT:-/root/autodl-tmp/ai-operator}"
export ARTIFACT_ROOT="${ARTIFACT_ROOT:-/root/autodl-tmp/experiment-artifacts}"
export MODEL_ROOT="${MODEL_ROOT:-/root/autodl-tmp/models}"
export DATA_ROOT="${DATA_ROOT:-${PROJECT_ROOT}/data/raw}"
export VENV_ROOT="${VENV_ROOT:-/root/autodl-tmp/venvs}"
export AI_OPERATOR_ENV_FILE="${AI_OPERATOR_ENV_FILE:-/root/autodl-tmp/ai-operator-runtime.env}"

export VLLM_VERSION=0.25.1
export VLLM_MAX_NUM_BATCHED_TOKENS=8192
export VLLM_MAX_NUM_SEQS=256
export VLLM_GPU_MEMORY_UTILIZATION=0.9

# audit_saor_formal_readiness.py verifies these values against this selection
# file (evidence SHA256 bc2042d74bfa4c5c9bf49d9abcd5e911d56e2be581e185d4eb586e155d53aa41).
export STRATEGY_CALIBRATION_SELECTION="${ARTIFACT_ROOT}/opening_multijob_calibration_selection_20260808.json"
export BEST_TOKEN_BUDGET=6144
export PROJECT_STATIC_K_PER_ENDPOINT=128
export PROJECT_ACTIVE_WORK_PER_ENDPOINT=65536
export PROJECT_ACTOR_WORKERS_PER_ENDPOINT=8
export PROJECT_RAY_ACTOR_MAX_CONCURRENCY=32
export PROJECT_RAY_WORKER_NUM_CPUS=0.25
export PROJECT_SHARED_CREDIT_QUANTUM=2048

# The final 10/10 rehearsal used the Chat request contract. Do not inherit the
# generic runtime env's legacy /v1/completions URL for this formal matrix.
export SOURCE_MAX_PROMPT_TOKENS=1500
export COMPLETION_ENDPOINT_URLS=http://127.0.0.1:8000/v1/chat/completions,http://127.0.0.1:8001/v1/chat/completions
export COMPLETION_MODEL=qwen2.5-7b
export COMPLETION_HTTP_KEEPALIVE_EXPIRY_S=4
export COMPLETION_PROTOCOL=chat_completions
# Calibrated for this exact model/template/protocol signature. Across the
# failed d85724fb rehearsal's 6,144 requests, endpoint usage minus the raw
# manifest prompt and actual output was uniformly 29 tokens. Recalibrate when
# the model, tokenizer, chat template, message shape, or protocol changes.
export COMPLETION_PROMPT_TOKEN_OVERHEAD=29
export COMPLETION_MAX_TOKENS=256
export MODEL_METRICS_URLS=http://127.0.0.1:8000/metrics,http://127.0.0.1:8001/metrics
export ENDPOINT_GPU_IDS=0,1
export MODEL_PATH="${MODEL_ROOT}/Qwen2.5-7B-Instruct"

export SAOR_ACTIVE_SET_WORKLOAD=sharegpt_multiturn
export SAOR_BULK_MANIFEST="${ARTIFACT_ROOT}/opening_multijob_manifests_20260808_work_balanced/long_512.jsonl"
export SAOR_FOREGROUND_MANIFEST="${ARTIFACT_ROOT}/opening_multijob_manifests_20260808_work_balanced/short_512.jsonl"
export SAOR_BULK_ROWS=512
export SAOR_FOREGROUND_ROWS=512
export SAOR_FOREGROUND_OFFSET_S=5
# 0.001 was the failed supply-reachability rehearsal. The final burst contract
# is 0.0001: it offers 140417/137617 predicted work before foreground@5s.
export SAOR_ARRIVAL_TIME_SCALE=0.0001
export SAOR_MAX_EFFECTIVE_MANIFEST_SPAN_S=120
export SAOR_MIN_PRE_FOREGROUND_WORK_ENVELOPES=1.0
# Same-machine logical Arrow payload envelope from the matched-ready
# rehearsal. This is not RSS and must be recalibrated when the machine,
# workload, row representation, or ready-window contract changes.
export SAOR_READY_PAYLOAD_BYTES_LIMIT_PER_JOB=67108864

export REQUEST_SLO_MS=30000
export GPU_PEAK_TFLOPS=165
export MFU_PRECISION=bf16_dense_fp32_accumulate
export RAY_ADDRESS=127.0.0.1:6380
export DRIVER_PYTHON=/root/miniconda3/bin/python
