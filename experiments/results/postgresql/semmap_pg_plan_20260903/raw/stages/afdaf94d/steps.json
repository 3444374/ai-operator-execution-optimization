[
  {
    "name": "preflight",
    "argv": [
      "<driver-env>/bin/python",
      "code/scripts/environment/manage_environment.py",
      "check",
      "--groups",
      "core",
      "--json-out",
      "<artifact-root>/preflight.json"
    ],
    "exit_code": 0
  },
  {
    "name": "version",
    "argv": [
      "<pg18.3-prefix>/bin/pg_config",
      "--version"
    ],
    "exit_code": 0
  },
  {
    "name": "build",
    "argv": [
      "make",
      "PG_CONFIG=<pg18.3-prefix>/bin/pg_config",
      "COPT=-O2 -Werror",
      "-j8"
    ],
    "exit_code": 0
  },
  {
    "name": "install",
    "argv": [
      "make",
      "PG_CONFIG=<pg18.3-prefix>/bin/pg_config",
      "install"
    ],
    "exit_code": 0
  },
  {
    "name": "test-owner",
    "argv": [
      "chown",
      "-R",
      "postgres:postgres",
      "<test-worktree>"
    ],
    "exit_code": 0
  },
  {
    "name": "tap",
    "argv": [
      "runuser",
      "-u",
      "postgres",
      "--",
      "env",
      "PATH=<pg18.3-prefix>/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "PG_TEST_NOCLEAN=1",
      "make",
      "PG_CONFIG=<pg18.3-prefix>/bin/pg_config",
      "installcheck",
      "REGRESS=",
      "PROVE_TESTS=t/006_map_plan.pl"
    ],
    "exit_code": 2
  }
]
