+    def _ready_wait_reason(self):
+        """Only wait for a partial ready group while its Job has issued work."""
+        if self.observation_failed or not self.pending:
+            return 'stopped'
+        job_id = self.pending[0].task.spec.job_id
+        if not any(row.sent and not row.future.done() and row.task.spec.job_id == job_id
+                   for row in self.rows.values()):
+            return 'no_issued_work'
+        size = count = 0
+        for row in self.pending:
+            if row.cancelled or row.future.done():
+                return 'cancelled'
+            if row.task.spec.job_id != job_id:
+                return 'different_job'
+            amount = len(row.task.task.payload) + 24
+            if size + amount > self.physical.window_bytes:
+                return 'window_bytes'
+            size += amount
+            count += 1
+            if count >= self.physical.batch_rows:
+                return 'batch_rows'
+        if self.physical.window_bytes - size < 24:
+            return 'window_bytes'
+        return None
+
+    async def _coalesce_ready(self):
+        if not self.physical.ready_wait_ms:
+            return
+        loop = asyncio.get_running_loop()
+        deadline = loop.time() + self.physical.ready_wait_ms / 1000
+        started = time.monotonic_ns() if self.observer else None
+        reason = self._ready_wait_reason()
+        while reason is None:
+            remaining = deadline - loop.time()
+            if remaining <= 0:
+                reason = 'deadline'
+                break
+            self.changed.clear()
+            try:
+                await asyncio.wait_for(self.changed.wait(), remaining)
+            except TimeoutError:
+                reason = 'deadline'
+                break
+            reason = self._ready_wait_reason()
+        if started is not None:
+            self._observe('ray_ready_wait', stage=reason, rows=len(self.pending),
+                          elapsed_ns=time.monotonic_ns()-started)
+
