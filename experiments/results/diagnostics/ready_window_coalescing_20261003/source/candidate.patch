@@ -0,0 +1,219 @@
+"""Bounded ready grouping through the real transport with simulated vendor calls."""
+import asyncio
+from dataclasses import replace
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from src.execution_provider.adapters.model_config import FixedModelConfig
+from src.execution_provider.adapters.ray_map_transport import RayMapConfig, RayMapTransport, _RemoteFailure, _RemoteResult
+from tests.execution_provider.test_ray_map_transport import FakeRay, task
+
+
+class Scalar:
+    def __init__(self, value): self.value = value
+    def as_py(self): return self.value
+
+
+class PreparedTable:
+    def __init__(self, rows):
+        self.rows, self.num_rows = rows, len(rows)
+
+    def __getitem__(self, name):
+        index = {'session_id': 0, 'sequence': 1, 'payload': 2}[name]
+        return [Scalar(row[index]) for row in self.rows]
+
+    def get_total_buffer_size(self):
+        return sum(len(row[2]) + 24 for row in self.rows)
+
+
+class ReadyConfigTests(unittest.TestCase):
+    def test_missing_field_keeps_old_default_and_invalid_wait_is_rejected(self):
+        old = dict(address='fixture-cluster', workers=1, batch_rows=4, window_bytes=1024, object_bytes=2048)
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'physical.json'
+            path.write_text(json.dumps(old))
+            self.assertEqual(RayMapConfig.load(path).ready_wait_ms, 0)
+        for value in (-1, float('nan'), float('inf'), True, '1'):
+            with self.subTest(value=value), self.assertRaisesRegex(ValueError, 'ready wait'):
+                RayMapConfig(**old, ready_wait_ms=value)
+
+
+class ReadyWindowTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.calls, self.prepared, self.events, self.responses, self.operations = [], [], [], {}, []
+        self.started = asyncio.Event()
+        self.transport = None
+        self.factory_patch = patch('src.execution_provider.adapters.ray_map_transport.iter_payload_batches',
+                                   self.batches)
+        self.factory_patch.start()
+
+    async def asyncTearDown(self):
+        try:
+            for response in self.responses.values():
+                if not response.done(): response.set_result(b'ok')
+            if self.operations: await asyncio.gather(*self.operations, return_exceptions=True)
+            if self.transport is not None: await self.transport.close()
+        finally:
+            self.factory_patch.stop()
+
+    def batches(self, rows, limits, *, batch_rows, backend):
+        self.assertLessEqual(len(rows), limits.rows)
+        self.assertLessEqual(sum(len(row[2]) + 24 for row in rows), limits.bytes)
+        self.prepared.append(tuple((row[0], row[1]) for row in rows))
+        for offset in range(0, len(rows), batch_rows):
+            yield PreparedTable(rows[offset:offset + batch_rows])
+
+    def make_transport(self, wait=0, window_bytes=1024, before_request=None):
+        async def execute(table, index, template, *args):
+            self.assertEqual(table['payload'][index].as_py(), b'payload')
+            response = asyncio.get_running_loop().create_future()
+            self.responses[template.key.sequence] = response
+            self.calls.append(template.key.sequence)
+            self.started.set()
+            result = await response
+            return _RemoteResult(template.key, result, 1, 2, None)
+        self.transport = RayMapTransport(FixedModelConfig('http://localhost/fixture', 'model', 1000), 8,
+            self.events.append, physical=RayMapConfig('fixture-cluster', 1, 4, window_bytes, 2048,
+                                                      ready_wait_ms=wait),
+            before_request=before_request, ray_api=FakeRay(execute))
+        return self.transport
+
+    def submit(self, sequence, job=None):
+        request = task(sequence)
+        if job is not None: request = replace(request, spec=replace(request.spec, job_id=job))
+        operation = asyncio.create_task(self.transport.execute(request, 'model'))
+        self.operations.append(operation)
+        return operation
+
+    async def wait_started(self, count):
+        async def wait():
+            while len(self.calls) < count:
+                self.started.clear()
+                await self.started.wait()
+        await asyncio.wait_for(wait(), 1)
+
+    async def first_outstanding(self):
+        self.submit(0)
+        await self.wait_started(1)
+        await self.transport.flusher
+
+    async def wave(self):
+        await self.first_outstanding()
+        self.submit(1)
+        await asyncio.sleep(0)
+        for sequence in range(2, 5): self.submit(sequence)
+        await self.wait_started(5)
+
+    async def test_old_default_preserves_immediate_three_window_path(self):
+        self.make_transport()
+        await self.wave()
+        self.assertEqual([len(window) for window in self.prepared], [1, 1, 3])
+        self.assertFalse(any(event['event'] == 'ray_ready_wait' for event in self.events))
+
+    async def test_full_ready_group_reduces_preparation_without_changing_requests(self):
+        self.make_transport(wait=100)
+        await self.wave()
+        self.assertEqual([len(window) for window in self.prepared], [1, 4])
+        self.assertEqual(self.calls, list(range(5)))
+        self.assertTrue(any(event.get('stage') == 'batch_rows' for event in self.events))
+        self.assertLessEqual(max(event['object_bytes'] for event in self.events), 2048)
+
+    async def test_first_row_never_waits_for_more_rows(self):
+        transport = self.make_transport(wait=1000)
+        with patch.object(transport.changed, 'wait', side_effect=AssertionError('first row must not wait')):
+            await self.first_outstanding()
+        self.assertEqual([len(window) for window in self.prepared], [1])
+
+    async def test_sparse_tail_flushes_at_deadline_with_issued_work_still_pending(self):
+        self.make_transport(wait=1)
+        await self.first_outstanding()
+        self.submit(1)
+        await self.wait_started(2)
+        self.assertFalse(self.responses[0].done())
+        self.assertTrue(any(event.get('stage') == 'deadline' for event in self.events))
+
+    async def test_exact_byte_limit_does_not_wait_for_impossible_extra_row(self):
+        self.make_transport(wait=1000, window_bytes=31)
+        await self.first_outstanding()
+        self.submit(1)
+        await self.wait_started(2)
+        self.assertTrue(any(event.get('stage') == 'window_bytes' for event in self.events))
+
+    async def test_different_job_is_not_held_for_another_jobs_batch(self):
+        self.make_transport(wait=1000)
+        await self.first_outstanding()
+        self.submit(1)
+        await asyncio.sleep(0)
+        self.submit(2, job='other')
+        await self.wait_started(3)
+        self.assertEqual(self.calls, [0, 1, 2])
+        self.assertTrue(any(event.get('stage') == 'different_job' for event in self.events))
+
+    async def test_byte_limit_flushes_before_reaching_target_rows(self):
+        self.make_transport(wait=1, window_bytes=70)
+        await self.wave()
+        self.assertTrue(all(len(window) <= 2 for window in self.prepared))
+        self.assertTrue(any(event.get('stage') == 'window_bytes' for event in self.events))
+
+    async def test_cancelling_queued_row_does_not_dispatch_it(self):
+        self.make_transport(wait=1000)
+        await self.first_outstanding()
+        operation = self.submit(1)
+        await asyncio.sleep(0)
+        self.transport.cancel_pending(task(1).key)
+        self.assertEqual(await asyncio.wait_for(operation, 1), b'')
+        self.assertEqual(self.calls, [0])
+
+    async def test_cancelled_delivery_future_wakes_waiter_and_never_dispatches(self):
+        self.make_transport(wait=1000)
+        await self.first_outstanding()
+        operation = self.submit(1)
+        await asyncio.sleep(0)
+        operation.cancel()
+        with self.assertRaises(asyncio.CancelledError): await operation
+        await asyncio.wait_for(self.transport.flusher, 1)
+        self.assertEqual(self.calls, [0])
+
+    async def test_last_issued_result_wakes_partial_group_before_wait_expires(self):
+        guard = asyncio.Event()
+        async def before(request):
+            if request.key.sequence == 1: await guard.wait()
+        self.make_transport(wait=1000, before_request=before)
+        self.submit(0)
+        self.submit(1)
+        await self.wait_started(1)
+        await self.transport.flusher
+        self.submit(2)
+        await asyncio.sleep(0)
+        self.responses[0].set_result(b'ok')
+        try:
+            await self.wait_started(2)
+            self.assertEqual(self.calls, [0, 2])
+            self.assertTrue(any(event.get('stage') == 'no_issued_work' for event in self.events))
+        finally:
+            guard.set()
+            await self.wait_started(3)
+
+
+class ReadyUnknownOutcomeTests(unittest.IsolatedAsyncioTestCase):
+    async def test_unconfirmed_remote_outcome_remains_charged_with_ready_wait_enabled(self):
+        async def execute(table, index, template, *args):
+            return _RemoteFailure(template.key, 'http', {'exception_type': 'fixture.error'})
+        def batches(rows, limits, *, batch_rows, backend):
+            yield PreparedTable(rows)
+        transport = RayMapTransport(FixedModelConfig('http://localhost/fixture', 'model', 1000), 4,
+            physical=RayMapConfig('fixture-cluster', 1, 2, 1024, 2048, ready_wait_ms=1),
+            ray_api=FakeRay(execute))
+        with patch('src.execution_provider.adapters.ray_map_transport.iter_payload_batches', batches):
+            with self.assertRaisesRegex(RuntimeError, 'unconfirmed'):
+                await transport.execute(task(0), 'model')
+            self.assertEqual(transport.unknown, {task(0).key})
+            self.assertGreater(transport.used_bytes, 0)
+            with self.assertRaisesRegex(RuntimeError, 'unconfirmed'):
+                await transport.close()
+
+
+if __name__ == '__main__': unittest.main()
