+def finalize_run(primary):
+    errors = report['finalization_errors'] = []
+    def failed(error, label):
+        nonlocal primary
+        errors.append(dict(step=label, type=type(error).__name__, message=redact_text(str(error))))
+        primary = _retain(primary, error, label)
+        report['status'] = 'failed'
+        report['error'] = dict(type=type(primary).__name__, message=redact_text(str(primary)),
+            notes=[redact_text(note) for note in getattr(primary, '__notes__', [])])
+    all_owned = set()
+    try:
+        try:
+            budget, receipt_errors = _terminal_budget()
+            report['model_budget'] = budget
+            for name, error in receipt_errors:
+                failed(error, 'read terminal receipt ' + name)
+            if report['status'] == 'completed' and not budget['accounting_complete']:
+                failed(RuntimeError('model invocation accounting is incomplete'), 'reconcile terminal ledger')
+        except BaseException as error:
+            report['model_budget']['engine_generate_invocations'] = None
+            failed(error, 'reconcile terminal ledger')
+        try:
+            write('LEDGER-TERMINAL.json', report['model_budget'])
+        except BaseException as error:
+            failed(error, 'write terminal ledger')
+        for item in report['stages']:
+            try:
+                all_owned.update(h.report_identities(item['supervisor']))
+            except BaseException as error:
+                failed(error, 'collect final identities')
+        try:
+            if h.live_owned(api, all_owned):
+                report['final_recovery'] = h.cleanup_owned(api, all_owned, 8)
+        except BaseException as error:
+            failed(error, 'recover final processes')
+        after = None
+        try:
+            after = h.snapshot(api, base, 'imlane-model-q3-after', all_owned)
+        except BaseException as error:
+            report['physical_idle'] = None
+            failed(error, 'snapshot final resources')
+        if after is not None:
+            try:
+                write('after.json', after)
+            except BaseException as error:
+                failed(error, 'write final resource snapshot')
+            try:
+                h.assert_idle(after, base)
+                report['physical_idle'] = True
+            except BaseException as error:
+                report['physical_idle'] = False
+                failed(error, 'verify final idle resources')
+        try:
+            report['live_owned_remaining'] = h.live_owned(api, all_owned)
+        except BaseException as error:
+            report['live_owned_remaining'] = None
+            failed(error, 'check final remaining processes')
+        report['owned_process_count'] = len(all_owned)
+    except BaseException as error:
+        failed(error, 'finalize run evidence')
+    finally:
+        try:
+            h.check_lease(lease)
+        except BaseException as error:
+            failed(error, 'check runner lease identity')
+        finally:
+            # release() performs its own owner-token check; a failed evidence
+            # write or separate identity observation must not skip this attempt.
+            try:
+                lease.release()
+            except BaseException as error:
+                failed(error, 'release runner lease')
+        try:
+            report['lease_released'] = not lease.path.exists()
+        except BaseException as error:
+            report['lease_released'] = None
+            failed(error, 'observe runner lease release')
+    if primary is not None:
+        report['status'] = 'failed'
+        report['error'] = dict(type=type(primary).__name__, message=redact_text(str(primary)),
+            notes=[redact_text(note) for note in getattr(primary, '__notes__', [])])
+    try:
+        write('FINAL.json', redact_json_values(report))
+    except BaseException as error:
+        failed(error, 'write final report')
+    try:
+        print(json.dumps(dict(phase='IMLANE_REAL_Q3_TERMINAL', status=report['status'],
+            engine_generate_invocations=report['model_budget']['engine_generate_invocations'],
+            physical_idle=report.get('physical_idle'), lease_released=report['lease_released'])), flush=True)
+    except BaseException as error:
+        failed(error, 'print terminal status')
+    return primary
+
+primary = None
