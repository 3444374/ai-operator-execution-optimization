+def _retain(primary, secondary, label):
+    if primary is None:
+        return secondary
+    primary.add_note(label + ': ' + type(secondary).__name__ + ': ' + redact_text(str(secondary)))
+    return primary
+
+
+def _terminal_budget():
+    directory = ROOT / 'cell/model-calls'
+    starts = {path.name.removesuffix('.started.json') for path in directory.glob('*.started.json')}
+    ends = {path.name.removesuffix('.terminal.json') for path in directory.glob('*.terminal.json')}
+    receipts, errors = [], []
+    known = 0
+    complete = bool(starts) and starts == ends
+    for name in sorted(ends):
+        path = directory / (name + '.terminal.json')
+        try:
+            receipt = json.loads(path.read_text())
+            count = receipt['engine_generate_invocations']
+            if count is not None and (type(count) is not int or count < 0):
+                raise ValueError('invalid terminal engine_generate_invocations')
+            row = dict(file=path.name, status=receipt['status'], engine_generate_invocations=count,
+                error_type=receipt.get('error_type'), calls=len(receipt['calls']))
+            if count is None:
+                complete = False
+            else:
+                known += count
+            receipts.append(row)
+        except BaseException as error:
+            complete = False
+            errors.append((path.name, error))
+    budget = dict(report['model_budget'], engine_generate_invocations=known if complete else None,
+        known_engine_generate_invocations=known, terminal_batches=receipts,
+        started_batches=len(starts), terminal_batch_files=len(ends), accounting_complete=complete,
+        missing_terminal_batches=sorted(starts - ends), unexpected_terminal_batches=sorted(ends - starts),
+        receipt_errors=[dict(file=name, type=type(error).__name__, message=redact_text(str(error)))
+                        for name, error in errors])
+    return budget, errors
+
